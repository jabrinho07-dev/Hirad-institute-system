PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Generate a unique secret locally. Do not use this placeholder.
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
AUTH_COOKIE_NAME=hirad_access
AUTH_COOKIE_SECURE=false
